{
  "name": "acan",
  "private": true,
  "version": "0.1.0",
  "description": "ACAN: passkey-guarded spending allowances for AI agents paying over x402 on Stellar",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test packages/core/test/*.test.ts packages/confidential/test/*.test.ts apps/agent/test/*.test.ts apps/mcp/test/*.test.ts apps/web/test/*.test.ts apps/site/test/*.test.ts apps/relay/test/*.test.mjs apps/cosigner/test/*.test.ts research/prototype/test/*.test.ts",
    "setup": "tsx scripts/setup.ts",
    "fund:usdc": "tsx scripts/fund-usdc.ts",
    "status": "tsx scripts/status.ts",
    "merchant": "tsx apps/merchant/src/server.ts",
    "merchant:b": "MERCHANT_PROFILE=b tsx apps/merchant/src/server.ts",
    "agent": "tsx apps/agent/src/agent.ts",
    "web": "npm run dev -w @acan/web",
    "site": "npm run dev -w @acan/site",
    "diagnose": "tsx scripts/diagnose.ts",
    "agent:private": "tsx apps/agent/src/agent-private.ts",
    "agent:ai": "tsx apps/agent/src/agent-ai.ts",
    "mcp": "tsx apps/mcp/src/server.ts",
    "agent:chat": "tsx apps/agent/src/chat-cli.ts",
    "agent:chat:server": "tsx apps/agent/src/chat-server.ts",
    "agent:settle": "tsx apps/agent/src/settle-tabs.ts",
    "agent:return": "tsx apps/agent/src/return-vault.ts",
    "ct:setup": "tsx scripts/ct-setup.ts",
    "audit": "tsx scripts/audit.ts",
    "receipt:verify": "tsx scripts/verify-receipt.ts",
    "guardian": "tsx scripts/guardian.ts",
    "cosigner": "tsx apps/cosigner/src/server.ts",
    "cosigner:setup": "tsx scripts/cosigner-setup.ts",
    "catalog:pin": "tsx scripts/pin-catalog.ts",
    "allowlist:deploy": "tsx scripts/deploy-allowlist.ts",
    "gate:deploy": "tsx scripts/deploy-gate.ts",
    "recovery:deploy": "tsx scripts/deploy-recovery.ts",
    "cosigner:bundle": "esbuild apps/cosigner/src/hosted-server.ts --bundle --platform=node --format=esm --target=node20 --outfile=apps/cosigner/deploy/hosted-cosigner.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --legal-comments=none",
    "deployment:publish": "tsx scripts/publish-deployment.ts",
    "demo:allowlist": "tsx scripts/demo-allowlist.ts",
    "demo:caps": "tsx scripts/demo-caps.ts",
    "demo:gate": "tsx scripts/demo-gate.ts",
    "merchant:cashout": "tsx scripts/merchant-cashout.ts",
    "ct:build": "cd vendor/ctd-demo && pnpm install && pnpm build:sdk",
    "test:contracts": "cd contracts && cargo test",
    "test:research": "node --import tsx --test research/prototype/test/*.test.ts && cd research/prototype/soroban && cargo test",
    "research:demo": "tsx research/prototype/scripts/demo.ts"
  },
  "overrides": {
    "@stellar/stellar-sdk": "16.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "smart-account-kit": "0.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
