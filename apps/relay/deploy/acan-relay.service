# systemd unit for the ACAN AI relay. Install: see apps/relay/README.md
[Unit]
Description=ACAN AI relay (demo site chat)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/acan/relay.env
Environment=HOST=127.0.0.1 PORT=8787 TRUST_PROXY=1
ExecStart=/usr/bin/node /opt/acan/apps/relay/server.mjs
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
