{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/core/src",
    "packages/confidential/src",
    "apps/merchant/src",
    "apps/agent/src",
    "apps/mcp/src",
    "apps/cosigner/src",
    "scripts"
  ],
  "exclude": [
    "apps/cosigner/src/hosted-server.ts"
  ]
}
